// ============================================
// NeuralShop - PostgreSQL Schema (Prisma)
// ============================================
// Purpose: Orders, Payments, Inventory, Idempotency
// MongoDB: Product, User
// Redis: Cart, Locks, Cache

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ADDRESS MODEL (User Addresses)
// ============================================

/// User saved addresses for shipping
model Address {
  id        String  @id @default(uuid())
  userId    String // Reference to MongoDB User
  label     String // Home, Work, etc.
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  phone     String? // Contact phone for this address
  isDefault Boolean @default(false) // Only one default per user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders Order[]

  @@index([userId])
  @@index([isDefault])
}

// ============================================
// ORDER MODELS (Multi-Vendor)
// ============================================

/// Main order record (status is derived from OrderItems)
model Order {
  id          String   @id @default(uuid())
  userId      String // Reference to MongoDB User
  status      String   @default("PENDING") // PENDING, PARTIALLY_SHIPPED, SHIPPED, DELIVERED, COMPLETED, CANCELLED (derived)
  totalAmount Float
  addressId   String // Reference to saved Address
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items   OrderItem[]
  payment Payment?
  address Address     @relation(fields: [addressId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Individual items in order (per seller)
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String // Reference to MongoDB Product
  name      String @default("") // Product name at purchase time
  image     String @default("") // Product image URL at purchase time
  size      String @default("M") // Size variant (XS, S, M, L, XL, XXL)
  sellerId  String // 🔥 Reference to seller (admin user)
  quantity  Int
  price     Float // Price at purchase time
  status    String @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@index([status])
}

// ============================================
// PAYMENT MODEL
// ============================================

/// Payment tracking for orders
model Payment {
  id                String   @id @default(uuid())
  orderId           String   @unique
  status            String   @default("pending") // pending, success, failed, refunded
  amount            Float
  provider          String // razorpay, stripe, etc
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// INVENTORY MODEL
// ============================================

/// Stock management for products (size-based)
model Inventory {
  productId     String // Reference to MongoDB Product
  size          String   @default("M") // Size variant (XS, S, M, L, XL, XXL)
  totalStock    Int // Total stock available
  reservedStock Int // Reserved during checkout
  updatedAt     DateTime @updatedAt

  // Composite key: (productId, size) is unique
  @@id([productId, size])
  @@index([productId])
}

// ============================================
// IDEMPOTENCY MODEL (Critical for Payment)
// ============================================

/// Prevents duplicate API requests
model IdempotencyKey {
  key       String   @id
  userId    String
  method    String // POST, GET, etc
  endpoint  String
  response  Json // Response to return
  status    String   @default("pending") // pending, completed, failed
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
}

// ============================================
// COUPON/DISCOUNT MODEL
// ============================================

/// Discount coupons and promotions
model Coupon {
  id             String @id @default(uuid())
  code           String @unique
  discountType   String // PERCENTAGE, FIXED
  discountValue  Float // Percentage (0-100) or fixed amount
  minOrderAmount Float? // Minimum order value to use coupon
  maxUses        Int? // Total uses allowed (null = unlimited)
  usedCount      Int    @default(0)
  maxUsesPerUser Int    @default(1) // Per user limit

  isActive   Boolean  @default(true)
  startDate  DateTime
  expiryDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderDiscounts OrderDiscount[]

  @@index([code])
  @@index([isActive])
  @@index([expiryDate])
}

// ============================================
// ORDER DISCOUNT MODEL (Coupon Usage)
// ============================================

/// Track which coupon was used on which order
model OrderDiscount {
  id       String @id @default(uuid())
  orderId  String
  couponId String

  discountAmount Float
  createdAt      DateTime @default(now())

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([orderId])
  @@index([couponId])
}

// ============================================
// RETURN/REFUND MODEL
// ============================================

/// Manage product returns and refunds
model ReturnRequest {
  id          String @id @default(uuid())
  orderItemId String
  userId      String // Reference to MongoDB User

  reason      String // DAMAGED, WRONG_ITEM, NOT_AS_DESCRIBED, CHANGED_MIND, etc
  description String?

  status       String @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, REFUNDED, COMPLETED
  refundAmount Float?
  refundStatus String @default("PENDING") // PENDING, PROCESSED, FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderItemId])
}

// ============================================
// GUEST CART MODEL (Persistence)
// ============================================

/// Persistent guest cart storage (complementary to Redis)
model GuestCart {
  id        String @id @default(uuid())
  sessionId String @unique // Browser session identifier

  items Json // [{productId, size, quantity, price, name, image}]
  total Float @default(0)

  expiresAt DateTime // Auto-cleanup after 7 days
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([expiresAt])
}
